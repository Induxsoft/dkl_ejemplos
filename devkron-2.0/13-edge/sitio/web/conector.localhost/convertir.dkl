// probar: parse
// Propósito: microconector HTTP para Devkron Edge (dkle): recibe un pedido JSON de una tienda en
// línea, lo valida, calcula importes con la configuración del sitio y responde el formato interno.
// - Incluye solo dkli.dkh y edge.dkh: corre igual en dkle y en Devkron 2 (donde edge.dkh carga
//   functions, serialize, url, text, time, hash, threads, http, oauth, listx, jsonx y env).
// - Edge no tiene base de datos, sistema de archivos ni interoperabilidad: solo HTTP.
// - Tampoco tiene httpres.ok ni httpres.fail (formato {success, data}): "dkle check" los marca como
//   error. Use httpres.json y httpres.status.
// - Para reenviar el resultado a otra API se usaría http.post_json (limitado por "outbound").
// Prueba: dkle run --root sitio --body @pedido.json POST /pedidos
#include "dkli.dkh"
#!
program "convertir"
{
    #include "edge.dkh"

    ref p = httpreq.json()
    ref items = field.dobj(p, "line_items", @null)
    if isnull(items)
    {
        new err
        {
            @"error": "El pedido no trae line_items"
        }
        do httpres.status(422)
        do httpres.json(err)
        return
    }
    iva = val(config.dget("iva", "0.16"))
    ref partidas = list.create()
    subtotal = 0
    for i=0; i<list.count(items)
    {
        ref it = list.atobj(items, i)
        importe = num.round(field.num(it, "price") * field.num(it, "quantity"), 2)
        subtotal = subtotal + importe
        new partida
        {
            @"sku": toupper(field.dstr(it, "sku", ""))
            @"cantidad": field.num(it, "quantity")
            @"importe": importe
        }
        partida -> partidas
    }
    new salida
    {
        @"pedido": field.dstr(p, "id", "")
        @"moneda": config.dget("moneda", "MXN")
        @"subtotal": subtotal
        @"iva": num.round(subtotal * iva, 2)
        @"total": num.round(subtotal * (1 + iva), 2)
        @"partidas*": partidas
    }
    do log.info("pedido " + field.dstr(p, "id", "") + " convertido")
    do httpres.json(salida)
}
