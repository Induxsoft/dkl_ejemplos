// Propósito: una flecha sobre una ref que vino de @@ con un campo inexistente, y por qué conviene field.exist.
// - @@(r, "&campo_inexistente") no devuelve una referencia nula nueva: devuelve 0, y "ref g = 0" apunta a la
//   ranura de objetos de @null, la que comparten todas las referencias nulas del programa.
// - Hasta Devkron 2.0.2, la flecha x -> g sobre esa ref creaba la lista EN ESA RANURA: desde ahí @null y cualquier
//   @@(..., "&no_existe") devolvían esa lista e isnull() dejaba de dar 1 en todo el programa.
// - Desde Devkron 2.0.3 ya no pasa: la flecha (y new, using, bloques $$ y "v : r<&k>") guarda el objeto en una
//   ranura nueva y solo g apunta a ella. @null sigue siendo nulo.
// - Aun así, el patrón recomendado es preguntar con field.exist(r, k) (o field.typeof) y crear la lista con
//   list.create() antes de la flecha: es claro y funciona igual en todas las versiones.
#include "dkli.dkh"
#!
program "ref-flecha"
{
    #include "functions.dkh"
    #include "serialize.dkh"

    // Forma recomendada
    new s {}
    for i=0; i<2
    {
        k = ifstr(i == 0, "a", "b")
        if not(field.exist(s, k))
        {
            ref nueva = list.create()
            s<k + "*">: nueva
        }
        ref h = @@(s, "&" + k)
        v = i + 1
        v -> h
    }
    do print("recomendada: " + to.json(s))
    do print("isnull(@null) = " + str(isnull(@null)))

    // Flecha directa sobre la ref que vino de @@ (en 2.0.2 y anteriores, 'a' y 'b' quedaban como la misma lista)
    new r {}
    x = 1
    y = 2
    ref g = @@(r, "&a")
    x -> g
    r<"a*">: g
    ref g = @@(r, "&b")
    do print("isnull(g) tras pedir un campo que no existe: " + str(isnull(g)))
    y -> g
    r<"b*">: g
    do print("directa:     " + to.json(r))
    do print("isnull(@null) = " + str(isnull(@null)) + "   <- en 2.0.2 daba 0")
    new vacio {}
    ref z = @@(vacio, "&lo_que_sea")
    do print("isnull(@@ de un campo inexistente) = " + str(isnull(z)) + "   <- en 2.0.2 daba 0")
    do print("field.exist: " + str(field.exist(vacio, "lo_que_sea")))
}
