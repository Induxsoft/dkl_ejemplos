// Propósito: en 2.0 un identificador puede empezar con $ (variables, funciones, parámetros, refs).
// $x y x son variables distintas. Útil, por ejemplo, para distinguir datos que vienen de afuera.
#include "dkli.dkh"
#!
program "dolar"
{
    #include "functions.dkh"
    #include "serialize.dkh"

    $total = 0
    for $i=1; $i<=3
    {
        $total = $total + $i
    }
    $doble::$v
    {
        return $v * 2
    }
    total = 1
    do print("$total=" + str($total) + " total=" + str(total) + " $doble=" + str($doble($total)))
    do print(ftext("marca: #<$total>"))
}
